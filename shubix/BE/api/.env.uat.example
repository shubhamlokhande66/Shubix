# UAT on your computer: npm run dev:uat (from shubix/). Copied to BE/api/.env.uat on the first run (kept out of git).
# Only what UAT does differently goes here; everything else (MONGODB_URI, R2 keys, OpenAI/Gemini keys, Google, SMTP)
# comes from BE/api/.env. The same values as the UAT server (infra/cloudflare/wrangler.jsonc env.uat).
MONGODB_DB=shubix_uat
R2_BUCKET=smgroup-uat
BILLING_ENABLED=true
# Cashfree test mode: test keys only (merchant.cashfree.com -> Switch to Test -> Developers -> API Keys)
CASHFREE_ENV=sandbox
# (left out: the ones in .env are used; filled in here: these win)
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
