# PROD on your computer: npm run dev:prod (from shubix/) reads only servers/prod/.env (kept out of git).
# CAREFUL: the live database and bucket of real users, and Cashfree takes real money. For looking into a problem
# only; try things on QA. The first run makes that file from BE/api/.env with the values below put in.
# MONGODB_DB: the live database's name (Atlas -> Browse Collections, where the users are); left out, .env's is kept
# MONGODB_DB=
R2_BUCKET=smgroup
BILLING_ENABLED=true
# live keys (merchant.cashfree.com in Live mode -> Developers -> API Keys), filled in servers/prod/.env
CASHFREE_ENV=production
