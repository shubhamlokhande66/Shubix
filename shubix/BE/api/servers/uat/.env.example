# UAT on your computer: npm run dev:uat (from shubix/) reads only servers/uat/.env (kept out of git).
# The first run makes that file from BE/api/.env with the values below put in (MONGODB_DB also goes into the
# MongoDB address, .../shubix_uat); after that change it there. The same values as the UAT server
# (infra/cloudflare/wrangler.jsonc env.uat).
MONGODB_DB=shubix_uat
R2_BUCKET=smgroup-uat
BILLING_ENABLED=true
# Cashfree test mode: test keys only (merchant.cashfree.com -> Switch to Test -> Developers -> API Keys)
CASHFREE_ENV=sandbox
