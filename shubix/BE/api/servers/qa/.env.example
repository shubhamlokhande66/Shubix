# QA on your computer: npm run dev:qa (from shubix/) reads only servers/qa/.env (kept out of git).
# The first run makes that file from BE/api/.env with the values below put in (MONGODB_DB also goes into the
# MongoDB address, .../shubix_qa); after that change it there. The same values as the QA server
# (infra/cloudflare/wrangler.jsonc env.qa).
MONGODB_DB=shubix_qa
R2_BUCKET=smgroup-qa
BILLING_ENABLED=true
# Cashfree test mode: test keys only (merchant.cashfree.com -> Switch to Test -> Developers -> API Keys)
CASHFREE_ENV=sandbox
