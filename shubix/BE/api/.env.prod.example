# PROD on your computer: npm run dev:prod (from shubix/). Copied to BE/api/.env.prod on the first run (kept out of git).
# CAREFUL: this is the live database and bucket of real users, and Cashfree takes real money. For checking a problem
# only; try things on QA. Everything not here comes from BE/api/.env.
MONGODB_DB=ai_reel_maker
R2_BUCKET=smgroup
BILLING_ENABLED=true
# live keys (merchant.cashfree.com in Live mode -> Developers -> API Keys)
CASHFREE_ENV=production
# (left out: the ones in .env are used; filled in here: these win)
