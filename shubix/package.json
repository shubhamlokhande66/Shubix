{
  "name": "shubix",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev:qa": "node scripts/dev.mjs qa",
    "dev:uat": "node scripts/dev.mjs uat",
    "dev:prod": "node scripts/dev.mjs prod",
    "web:qa": "node scripts/dev.mjs qa --web",
    "web:uat": "node scripts/dev.mjs uat --web",
    "web:prod": "node scripts/dev.mjs prod --web",
    "dev:mobile": "npx -y pnpm@10.20.0 --filter @shubix/mobile-app start",
    "build": "npx -y pnpm@10.20.0 -r build",
    "typecheck": "npx -y pnpm@10.20.0 -r typecheck",
    "test": "npx -y pnpm@10.20.0 -r --workspace-concurrency=1 --no-bail test",
    "setup": "npx -y pnpm@10.20.0 install",
    "android:aab": "npx -y pnpm@10.20.0 --filter @shubix/mobile-app aab",
    "backup:keys": "node scripts/backup-keys.mjs"
  }
}
